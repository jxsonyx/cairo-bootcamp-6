# Starknet Configuration
STARKNET_RPC_URL=https://starknet-sepolia.public.blastapi.io
STARKNET_ACCOUNT_ADDRESS=0x...
STARKNET_PRIVATE_KEY=0x...

# Transfer Agent Configuration
# Minimum balance threshold (in ETH) - alerts trigger below this
MIN_BALANCE_THRESHOLD=0.01

# Transfer threshold (in ETH) - transfers execute when balance exceeds this
TRANSFER_THRESHOLD=0.1

# Default transfer amount (in ETH)
DEFAULT_TRANSFER_AMOUNT=0.05

# Recipient address for automated transfers
RECIPIENT_ADDRESS=0x...

# Check interval in milliseconds (default: 60000 = 1 minute)
CHECK_INTERVAL_MS=60000

# Token to monitor (ETH, STRK, USDC, or contract address)
MONITOR_TOKEN=ETH

# Alert webhook URL (optional - for external notifications)
ALERT_WEBHOOK_URL=

# URL of next agent in workflow chain (optional)
NEXT_AGENT_URL=

# Enable auto-transfer mode (true/false)
AUTO_TRANSFER_ENABLED=false

# Maximum transfers per session (safety limit)
MAX_TRANSFERS_PER_SESSION=10
